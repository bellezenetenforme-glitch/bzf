# Variables d'environnement pour la Netlify Function (Resend).
# Renseigne-les dans le dashboard Netlify (Site settings > Environment variables)
# ou dans un fichier local .env quand tu utilises `netlify dev`.

# Clé API Resend (https://resend.com/api-keys) — REQUISE pour l'envoi réel
RESEND_API_KEY=

# Email de destination des réponses du formulaire
# (par défaut : CONTACT_EMAIL)
CONTACT_EMAIL=bellezenetenforme@gmail.com
TO_EMAIL=

# Email d'expéditeur autorisé dans Resend (à valider dans Resend)
# Format : "Nom <email>" — pendant la phase de test : "BZF <onboarding@resend.dev>"
FROM_EMAIL=BZF <onboarding@resend.dev>

# Anti-spam : origines autorisées à appeler la fonction (séparées par des virgules).
# Laisse VIDE pour utiliser la liste par défaut (ton domaine + *.netlify.app + localhost).
# ⚠️ Toute origine absente de cette liste est REJETÉE SILENCIEUSEMENT : la page affiche
# "envoyé" mais aucun email n'est envoyé. Si tu changes de domaine, ajoute-le ici.
# Écris des noms d'hôtes SANS le port. Un point devant vaut suffixe : ".netlify.app".
# ALLOWED_ORIGINS=bellezenetenforme.fr,www.bellezenetenforme.fr,.netlify.app,localhost
