# NOTE : copie ce fichier en `.env` et remplis les valeurs avant de lancer le serveur.
# Ne commit jamais le fichier `.env` réel.

# --- Port d'écoute du serveur ---
PORT=4000

# --- Base URL du front, autorisée à appeler l'API (CORS) ---
# 'true' autorise toutes les origines (pratique en dev). Sinon, liste la/les URL exacte(s).
CLIENT_ORIGIN=true

# --- Email de destination des réponses ---
CONTACT_EMAIL=bellezenetenforme@gmail.com

# --- Transporteur SMTP (ex: Gmail, Outlook, Zoho, Brevo...) ---
# Exemple Gmail (mot de passe d'application, PAS ton mot de passe Gmail) :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tonadresse@gmail.com
SMTP_PASS=ton-mot-de-passe-d-application
# Email d'expedition affiche (par défaut SMTP_USER s'il est vide)
SMTP_FROM=

# --- Si tu ne veux PAS envoyer de vrai email (mode dev), passe MAIL_DRY_RUN=true
# Le message est ecrit dans la console au lieu d'etre envoye.
MAIL_DRY_RUN=false
